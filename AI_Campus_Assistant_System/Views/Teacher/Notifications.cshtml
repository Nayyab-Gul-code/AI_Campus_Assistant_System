@model IEnumerable<AI_Campus_Assistant.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="card" style="border: 1px solid #CCFBF1; box-shadow: 0 4px 20px rgba(13,144,105,0.04); background: #ffffff; border-radius: 16px; margin-bottom: 24px;">
    <div class="card-header" style="background: linear-gradient(90deg, #F0FDFB 0%, #CCFBF1 100%); border-bottom: 1px solid #99F6E4; padding: 18px 24px; display: flex; align-items: center; justify-content: space-between; border-radius: 16px 16px 0 0;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 38px; height: 38px; background: #0D9069; color: #fff; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 18px; box-shadow: 0 4px 10px rgba(13,144,105,0.2);">
                <i class="bi bi-bell-fill"></i>
            </div>
            <div>
                <h3 class="card-title" style="font-size: 16px; font-weight: 800; color: #0F172A; margin: 0; padding: 0;">
                    System Announcements & BroadCasts
                </h3>
                <p style="font-size: 11px; color: #475569; margin: 2px 0 0 0; font-weight: 500;">Stay updated with real-time administration notices</p>
            </div>
        </div>
        <span class="badge badge-purple" style="padding: 6px 14px; font-size: 11px; border-radius: 30px; font-weight: 700; box-shadow: 0 2px 6px rgba(108,99,255,0.15);">
            <i class="bi bi-layers-half" style="margin-right: 4px;"></i> @Model.Count() Updates Total
        </span>
    </div>

    <div class="card-body" style="background: #ffffff; padding: 24px;">
        @if (!Model.Any())
        {
            <div class="empty-state" style="padding: 60px 20px;">
                <div style="width: 80px; height: 80px; background: #F0FDFB; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px; border: 1px dashed #99F6E4;">
                    <i class="bi bi-envelope-open" style="color: #0D9069; opacity: 0.8; font-size: 32px; display: inline;"></i>
                </div>
                <h4 style="font-size: 16px; font-weight: 800; color: #1E293B;">All Caught Up!</h4>
                <p style="max-width: 360px; margin: 6px auto 0; color: #64748B;">There are no active alerts, announcements, or messages published for your department stream right now.</p>
            </div>
        }
        else
        {
            <div style="display: flex; flex-direction: column; gap: 16px;">
                @foreach (var item in Model)
                {
                    string badgeTypeClass = "badge-info";
                    string leftBorderColor = "#1A6FD4";
                    string bgAccentGlow = "rgba(26,111,212,0.01)";

                    switch (item.Type?.ToLower())
                    {
                        case "success":
                            badgeTypeClass = "badge-success";
                            leftBorderColor = "#0D9069";
                            bgAccentGlow = "rgba(13,144,105,0.01)";
                            break;
                        case "warning":
                            badgeTypeClass = "badge-warning";
                            leftBorderColor = "#D97706";
                            bgAccentGlow = "rgba(217,119,6,0.01)";
                            break;
                        case "danger":
                            badgeTypeClass = "badge-danger";
                            leftBorderColor = "#E11D48";
                            bgAccentGlow = "rgba(225,29,72,0.01)";
                            break;
                    }

                    <div class="premium-notification-card" style="
                        background: #ffffff;
                        border: 1px solid #E2E8F0;
                        border-left: 6px solid @leftBorderColor;
                        border-radius: 12px;
                        padding: 18px 20px;
                        display: flex;
                        flex-direction: column;
                        gap: 10px;
                        position: relative;
                        transition: all 0.25s ease-in-out;
                        box-shadow: 0 2px 5px rgba(0,0,0,0.01);
                        opacity: @(item.IsRead ? "0.75" : "1");">

                        <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span class="badge @badgeTypeClass" style="text-transform: uppercase; font-size: 9.5px; padding: 4px 10px; font-weight: 800; letter-spacing: 0.6px; border-radius: 6px;">
                                    ● @item.Type
                                </span>
                                @if (!item.IsRead)
                                {
                                    <span style="background: #EF4444; width: 6px; height: 6px; border-radius: 50%; display: inline-block;" title="New Update"></span>
                                }
                            </div>

                            <div style="font-size: 12px; color: #94A3B8; font-weight: 500; display: flex; align-items: center; gap: 6px; background: #F8FAFC; padding: 3px 10px; border-radius: 30px; border: 1px solid #F1F5F9;">
                                <i class="bi bi-clock-history" style="color: #64748B;"></i>
                                <span>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy • hh:mm tt")</span>
                            </div>
                        </div>

                        <div style="padding-left: 2px;">
                            <h4 style="font-size: 15px; font-weight: 700; color: #0F172A; margin: 0 0 6px 0; line-height: 1.3; letter-spacing: -0.1px;">
                                @item.Title
                            </h4>

                            <p style="font-size: 13.5px; color: #475569; line-height: 1.55; margin: 0; font-weight: 400; text-align: justify;">
                                @item.Message
                            </p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .premium-notification-card:hover {
        transform: translateY(-3px) scale(1.002);
        box-shadow: 0 10px 25px rgba(13,144,105,0.08) !important;
        border-color: #99F6E4 !important;
        background: linear-gradient(180deg, #ffffff 0%, #FAFEFD 100%) !important;
    }
</style>