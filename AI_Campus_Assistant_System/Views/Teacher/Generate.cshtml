@{
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";

    ViewData["Title"] = "Quiz / Assignment Generator";

    var courses = ViewBag.Courses as List<AI_Campus_Assistant.Models.Course> ?? new();

    var generated = ViewBag.Generated as string;

    var solutions = ViewBag.Solutions as string;

    var genType = ViewBag.Type as string ?? "quiz";

    var topic = ViewBag.Topic as string ?? "";
}

<style>
    .gen-card {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #E2E8F0;
        padding: 28px;
    }

    .result-box {
        background: #F8FAFF;
        border: 1.5px solid #BFDBFE;
        border-radius: 12px;
        padding: 20px 24px;
        font-size: 14px;
        line-height: 1.8;
        white-space: pre-wrap;
        color: #1e293b;
        min-height: 200px;
    }

    .tab-btn {
        padding: 9px 22px;
        border-radius: 8px;
        border: 1.5px solid #E2E8F0;
        background: #fff;
        font-size: 13.5px;
        font-weight: 700;
        cursor: pointer;
        color: #64748B;
        transition: .2s;
    }

        .tab-btn.active {
            background: #1A6FD4;
            color: #fff;
            border-color: #1A6FD4;
        }

    .spinner-border {
        width: 1rem;
        height: 1rem;
        margin-right: 5px;
    }
</style>

<div style="margin-bottom:22px;">
    <h4 style="font-weight:800;color:#0F172A;margin:0;"><i class="bi bi-cpu-fill" style="color:#1A6FD4;"></i> AI Content Generator</h4>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="gen-card shadow-sm">
            <form method="post" action="/Teacher/Generate" id="aiForm">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label fw-semibold">Generate Type</label>
                    <div class="d-flex gap-2">
                        <button type="button" class="tab-btn @(genType!="assignment" ? "active" : "")" onclick="updateType(this, 'quiz')"><i class="bi bi-patch-question-fill"></i> Quiz</button>
                        <button type="button" class="tab-btn @(genType=="assignment" ? "active" : "")" onclick="updateType(this, 'assignment')"><i class="bi bi-file-earmark-text-fill"></i> Assignment</button>
                    </div>
                    <input type="hidden" name="type" id="typeInput" value="@genType" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Course</label>
                    <select name="courseId" class="form-select">
                        <option value="">-- General / Optional --</option>
                        @foreach (var c in courses)
                        {
                            <option value="@c.Id">@c.Title</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Topic <span class="text-danger">*</span></label>
                    <input name="topic" class="form-control" value="@topic" required />
                </div>

                <div class="row g-2 mb-4">
                    <div class="col-6" id="countDiv">
                        <label class="form-label fw-semibold">Questions</label>
                        <select name="count" class="form-select">
                            <option value="5" selected>5</option>
                            <option value="10">10</option>
                        </select>
                    </div>
                    <div class="col-6" id="formatDiv">
                        <label class="form-label fw-semibold">Quiz Format</label>
                        <select name="quizFormat" class="form-select">
                            <option value="mcq">MCQ Based</option>
                            <option value="subjective">Question Based</option>
                        </select>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100" id="genBtn"><i class="bi bi-stars"></i> Generate with AI</button>
            </form>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="gen-card shadow-sm">
            @if (!string.IsNullOrEmpty(generated))
            {
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-success">✅ GENERATED</span>
                    <div class="d-flex gap-2">
                        <form method="post" action="/Teacher/Generate">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="type" value="@genType" /><input type="hidden" name="topic" value="@topic" /><input type="hidden" name="downloadType" value="questions" />
                            <button type="submit" class="btn btn-sm btn-primary">Download Qs</button>
                        </form>
                        <form method="post" action="/Teacher/Generate">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="type" value="@genType" /><input type="hidden" name="topic" value="@topic" /><input type="hidden" name="downloadType" value="solutions" />
                            <button type="submit" class="btn btn-sm btn-warning">Download Sol</button>
                        </form>
                    </div>
                </div>
                <div class="result-box">
                    <strong>QUESTIONS:</strong><br />@generated
                    <hr /><strong>SOLUTIONS:</strong><br />@solutions
                </div>
            }
        </div>
    </div>
</div>

<script>
    function updateType(btn, t) {
        document.getElementById('typeInput').value = t;
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('countDiv').style.display = (t === 'quiz') ? 'block' : 'none';
        document.getElementById('formatDiv').style.display = (t === 'quiz') ? 'block' : 'none';
    }
    document.getElementById('aiForm').addEventListener('submit', () => {
        document.getElementById('genBtn').disabled = true;
        document.getElementById('genBtn').innerHTML = 'Generating...';
    });
</script>