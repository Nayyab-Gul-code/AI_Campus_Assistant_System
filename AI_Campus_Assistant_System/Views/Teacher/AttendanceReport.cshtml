@{
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";

    ViewData["Title"] = "Attendance Report";



    var courses = ViewBag.Courses as List<AI_Campus_Assistant.Models.Course> ?? new();

    var records = ViewBag.Records as List<AI_Campus_Assistant.Models.Attendance>;

    var selCourse = ViewBag.SelCourse as AI_Campus_Assistant.Models.Course;
}

<div style="display:flex;gap:20px;align-items:flex-start;">

    <!-- Course Selector -->
    <div class="card" style="width:260px;flex-shrink:0;">
        <div class="card-header">
            <span class="card-title" style="font-size:13px;">
                <i class="bi bi-book-fill" style="color:#0D9069;margin-right:5px;"></i>
                Select Course
            </span>
        </div>

        <div style="padding:8px;">
            @foreach (var c in courses)
            {

                var isSel = selCourse?.Id == c.Id;

                <a href="/Teacher/AttendanceReport?courseId=@c.Id"
                   style="display:block;padding:10px 12px;border-radius:9px;margin-bottom:3px;text-decoration:none;
                  background:@(isSel ? "#CCFBF1" : "transparent");
                  border:1.5px solid @(isSel ? "#0D9069" : "transparent");">

                    <div style="font-size:13px;font-weight:@(isSel ? "800" : "600");
                      color:@(isSel ? "#0D9069" : "#0F172A");">
                        @c.Title
                    </div>

                    <div style="font-size:11px;color:#94A3B8;">
                        @c.Program · Sem @c.SemesterNo
                    </div>

                </a>
            }

            @if (!courses.Any())
            {
                <div style="padding:14px;font-size:12.5px;color:#94A3B8;text-align:center;">
                    No courses assigned
                </div>
            }
        </div>
    </div>

    <!-- Report Section -->
    <div style="flex:1;">

        @if (selCourse != null && records != null)

        {

            var total = records.Count;

            var present = records.Count(a => a.Status == "present");

            var absent = records.Count(a => a.Status == "absent");

            var late = records.Count(a => a.Status == "late");

            <!-- Banner -->
            <div style="background:linear-gradient(135deg,#042F2E,#0D9069);
                  border-radius:13px;padding:16px 20px;margin-bottom:16px;
                  display:flex;align-items:center;justify-content:space-between;">

                <div>
                    <div style="color:rgba(255,255,255,.6);font-size:11.5px;">
                        Attendance Report
                    </div>

                    <div style="color:#fff;font-size:17px;font-weight:800;">
                        @selCourse.Title
                    </div>

                    <div style="color:rgba(255,255,255,.5);font-size:12px;">
                        @selCourse.Program · Semester @selCourse.SemesterNo
                    </div>
                </div>

                <button onclick="downloadCSV()"
                        class="btn btn-secondary btn-sm"
                        style="background:rgba(255,255,255,.15);color:#fff;border-color:rgba(255,255,255,.2);">
                    <i class="bi bi-file-earmark-excel-fill"></i> Export CSV
                </button>
            </div>

            <!-- Stats -->
            <div class="stat-grid" style="grid-template-columns:repeat(4,1fr);margin-bottom:16px;">

                <div class="stat-card">
                    <div class="sc-icon sci-teal"><i class="bi bi-clipboard-data-fill"></i></div>
                    <div><div class="sc-val">@total</div><div class="sc-lbl">Total</div></div>
                </div>

                <div class="stat-card">
                    <div class="sc-icon sci-green"><i class="bi bi-check-circle-fill"></i></div>
                    <div><div class="sc-val">@present</div><div class="sc-lbl">Present</div></div>
                </div>

                <div class="stat-card">
                    <div class="sc-icon sci-red"><i class="bi bi-x-circle-fill"></i></div>
                    <div><div class="sc-val">@absent</div><div class="sc-lbl">Absent</div></div>
                </div>

                <div class="stat-card">
                    <div class="sc-icon sci-amber"><i class="bi bi-clock-fill"></i></div>
                    <div><div class="sc-val">@late</div><div class="sc-lbl">Late</div></div>
                </div>

            </div>

            <!-- Table -->
            <div class="card">
                <div class="card-header">
                    <span class="card-title">
                        <i class="bi bi-table" style="color:#0D9069;margin-right:5px;"></i>
                        Attendance Records (@total)
                    </span>
                </div>

                <div class="table-wrap">
                    <table id="attTable">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var r in records.OrderByDescending(r => r.Date))

                            {
                                <tr>
                                    <td>@r.StudentName</td>
                                    <td>@r.Date.ToString("dd MMM yyyy")</td>
                                    <td>@r.Status</td>
                                    <td>@(r.Remarks ?? "—")</td>
                                </tr>
                            }
                        </tbody>

                    </table>

                    @if (!records.Any())
                    {
                        <div class="empty-state">
                            No attendance records found
                        </div>
                    }

                </div>
            </div>

        }

        else

        {
            <div class="card">
                <div class="empty-state">
                    Select a course to view report
                </div>
            </div>
        }

    </div>
</div>

<!-- ================= SCRIPT FIXED ================= -->
<script>
    function downloadCSV() {

        var table = document.getElementById('attTable');
        if (!table) return;

        var rows = Array.from(table.querySelectorAll('tr'));

        var csv = rows.map(function (r) {
            return Array.from(r.querySelectorAll('th,td'))
                .map(function (c) {
                    return '"' + c.textContent.trim().replace(/"/g, '""') + '"';
                }).join(',');
        }).join('\n');

        var blob = new Blob([csv], { type: 'text/csv' });
        var url = URL.createObjectURL(blob);

        var a = document.createElement('a');
        a.href = url;

        // ✅ FIXED LINE (no .csv Razor error)
        a.download =
            'Attendance_' +
            '@(selCourse?.Title?.Replace(" ", "_") ?? "Report")' +
            '_@DateTime.Today.ToString("yyyyMMdd")' +
            '.csv';

        a.click();
        URL.revokeObjectURL(url);
    }
</script>