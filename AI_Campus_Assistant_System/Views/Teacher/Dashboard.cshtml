@{
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    ViewData["Title"] = "Dashboard";
    var courses   = ViewBag.Courses   as List<AI_Campus_Assistant.Models.Course>       ?? new();
    var notifs    = ViewBag.Notifications as List<AI_Campus_Assistant.Models.Notification> ?? new();
}

<div style="background:linear-gradient(135deg,#042F2E,#0D9069);border-radius:16px;padding:22px 26px;margin-bottom:22px;display:flex;align-items:center;justify-content:space-between;overflow:hidden;position:relative;">
  <div style="position:absolute;width:280px;height:280px;border-radius:50%;background:rgba(255,255,255,.04);top:-80px;right:-40px;"></div>
  <div style="position:relative;z-index:1;">
    <div style="color:rgba(255,255,255,.6);font-size:12px;font-weight:600;margin-bottom:4px;">Welcome back 👋</div>
    <div style="color:#fff;font-size:20px;font-weight:800;">@User.Identity?.Name</div>
    <div style="color:rgba(255,255,255,.5);font-size:13px;margin-top:4px;">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</div>
  </div>
  <div style="position:relative;z-index:1;text-align:right;">
    <div style="color:rgba(255,255,255,.5);font-size:11px;text-transform:uppercase;letter-spacing:.5px;">My Courses</div>
    <div style="color:#fff;font-size:28px;font-weight:900;">@courses.Count</div>
  </div>
</div>

<div class="stat-grid">
  <div class="stat-card"><div class="sc-icon sci-teal"><i class="bi bi-book-fill"></i></div><div><div class="sc-val" data-count="@ViewBag.TotalCourses">0</div><div class="sc-lbl">Courses</div></div></div>
  <div class="stat-card"><div class="sc-icon sci-blue"><i class="bi bi-calendar-check-fill"></i></div><div><div class="sc-val" data-count="@ViewBag.TotalAttendance">0</div><div class="sc-lbl">Attendance Records</div></div></div>
  <div class="stat-card"><div class="sc-icon sci-amber"><i class="bi bi-pencil-square"></i></div><div><div class="sc-val" data-count="@ViewBag.TotalAssignments">0</div><div class="sc-lbl">Assignments</div></div></div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;">
  <!-- My Courses -->
  <div class="card">
    <div class="card-header">
      <span class="card-title"><i class="bi bi-book-fill" style="color:#0D9069;margin-right:6px;"></i>My Courses</span>
      <a href="/Teacher/Courses" class="btn btn-secondary btn-sm">View All</a>
    </div>
    <div style="padding:0;">
      @foreach (var c in courses.Take(5))
      {
        <div style="padding:12px 18px;border-bottom:1px solid #F1F5F9;display:flex;align-items:center;gap:12px;">
          <div style="width:38px;height:38px;border-radius:10px;background:#CCFBF1;color:#0D9069;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;flex-shrink:0;">
            @c.Code.Substring(0,Math.Min(2,c.Code.Length))
          </div>
          <div style="flex:1;">
            <div style="font-size:13.5px;font-weight:700;color:#0F172A;">@c.Title</div>
            <div style="font-size:11.5px;color:#94A3B8;">@c.Program · Semester @c.SemesterNo · @c.Credits cr</div>
          </div>
          <span class="badge badge-success">@c.Code</span>
        </div>
      }
      @if (!courses.Any())
      { <div style="padding:24px;text-align:center;color:#94A3B8;font-size:13px;">No courses assigned yet</div> }
    </div>
  </div>

  <!-- Notifications -->
  <div class="card">
    <div class="card-header">
      <span class="card-title"><i class="bi bi-bell-fill" style="color:#D97706;margin-right:6px;"></i>Notifications</span>
    </div>
    <div style="padding:0;">
      @foreach (var n in notifs.Take(5))
      {
        var cl = n.Type=="success"?"#0D9069":n.Type=="warning"?"#D97706":n.Type=="danger"?"#E11D48":"#1A6FD4";
        var ic = n.Type=="success"?"check-circle-fill":n.Type=="warning"?"exclamation-triangle-fill":n.Type=="danger"?"x-circle-fill":"info-circle-fill";
        <div style="padding:11px 18px;border-bottom:1px solid #F1F5F9;display:flex;gap:10px;align-items:flex-start;">
          <i class="bi bi-@ic" style="color:@cl;font-size:15px;margin-top:1px;flex-shrink:0;"></i>
          <div>
            <div style="font-size:13.5px;font-weight:600;color:#0F172A;">@n.Title</div>
            <div style="font-size:11.5px;color:#94A3B8;">@n.CreatedAt.ToString("MMM dd")</div>
          </div>
        </div>
      }
      @if (!notifs.Any())
      { <div style="padding:24px;text-align:center;color:#94A3B8;font-size:13px;">No notifications</div> }
    </div>
  </div>
</div>

<!-- Quick Actions -->
<div class="card" style="margin-top:18px;">
  <div class="card-header"><span class="card-title"><i class="bi bi-lightning-fill" style="color:#D97706;margin-right:6px;"></i>Quick Actions</span></div>
  <div class="card-body" style="display:flex;gap:12px;flex-wrap:wrap;">
    <a href="/Teacher/Attendance"      class="btn btn-primary"><i class="bi bi-calendar-check-fill"></i> Mark Attendance</a>
    <a href="/Teacher/Assignments"     class="btn btn-secondary"><i class="bi bi-pencil-square"></i> Create Assignment</a>
    <a href="/Teacher/GradeSubmissions" class="btn btn-secondary"><i class="bi bi-award-fill"></i> Grade Students</a>
    
    <a href="/Teacher/Students"        class="btn btn-secondary"><i class="bi bi-people-fill"></i> View Students</a>
  </div>
</div>
<script src="/js/site.js"></script>
