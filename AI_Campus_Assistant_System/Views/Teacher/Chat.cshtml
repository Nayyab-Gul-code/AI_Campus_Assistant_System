@{
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    ViewData["Title"] = "AI Chat";
    var history = ViewBag.History as List<AI_Campus_Assistant.Models.ChatQuery> ?? new();
    var faqs    = ViewBag.Faqs   as List<AI_Campus_Assistant.Models.FAQ>       ?? new();
}
<style>
.chat-wrap{display:grid;grid-template-columns:1fr 280px;gap:18px;height:calc(100vh - 160px);}
.chat-main{display:flex;flex-direction:column;background:#fff;border-radius:14px;border:1px solid #E2E8F0;overflow:hidden;}
.chat-header{padding:16px 20px;border-bottom:1px solid #E2E8F0;display:flex;align-items:center;gap:12px;}
.ai-avatar{width:40px;height:40px;border-radius:12px;background:linear-gradient(135deg,#1A6FD4,#60A5FA);display:flex;align-items:center;justify-content:center;font-size:19px;flex-shrink:0;}
.chat-messages{flex:1;overflow-y:auto;padding:20px;display:flex;flex-direction:column;gap:16px;}
.msg{display:flex;gap:10px;max-width:85%;}
.msg.user{align-self:flex-end;flex-direction:row-reverse;}
.msg-avatar{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;flex-shrink:0;}
.msg-bubble{padding:11px 15px;border-radius:12px;font-size:13.5px;line-height:1.6;}
.msg.ai .msg-avatar{background:linear-gradient(135deg,#1A6FD4,#60A5FA);color:#fff;}
.msg.ai .msg-bubble{background:#F0F7FF;color:#0F172A;border-bottom-left-radius:4px;}
.msg.user .msg-avatar{background:linear-gradient(135deg,#6C63FF,#A78BFA);color:#fff;}
.msg.user .msg-bubble{background:linear-gradient(135deg,#1A6FD4,#1d4ed8);color:#fff;border-bottom-right-radius:4px;}
.msg-time{font-size:10.5px;color:#94A3B8;margin-top:4px;}
.chat-input{padding:14px 18px;border-top:1px solid #E2E8F0;display:flex;gap:10px;align-items:flex-end;}
.chat-input textarea{flex:1;padding:10px 14px;border:1.5px solid #E2E8F0;border-radius:10px;font-size:13.5px;font-family:'Inter',sans-serif;resize:none;outline:none;max-height:100px;min-height:42px;transition:.18s;color:#0F172A;}
.chat-input textarea:focus{border-color:#1A6FD4;box-shadow:0 0 0 3px rgba(26,111,212,.1);}
.send-btn{width:42px;height:42px;border-radius:10px;background:linear-gradient(135deg,#1A6FD4,#1d4ed8);color:#fff;border:none;cursor:pointer;font-size:17px;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:.18s;}
.send-btn:hover{transform:scale(1.05);box-shadow:0 4px 14px rgba(26,111,212,.35);}

.sidebar-panel{display:flex;flex-direction:column;gap:14px;overflow-y:auto;}
.faq-card{background:#fff;border-radius:13px;border:1px solid #E2E8F0;overflow:hidden;}
.faq-card-header{padding:12px 16px;border-bottom:1px solid #E2E8F0;font-size:13.5px;font-weight:700;color:#0F172A;display:flex;align-items:center;gap:8px;}
.faq-item{padding:10px 14px;border-bottom:1px solid #F0F7FF;cursor:pointer;transition:.15s;}
.faq-item:last-child{border-bottom:none;}
.faq-item:hover{background:#F0F7FF;}
.faq-q{font-size:12.5px;font-weight:600;color:#1A6FD4;}
.faq-a{font-size:11.5px;color:#64748B;margin-top:3px;line-height:1.5;}

.welcome-msg{text-align:center;padding:32px 20px;color:#64748B;}
.welcome-msg .ai-big{width:60px;height:60px;border-radius:16px;background:linear-gradient(135deg,#1A6FD4,#60A5FA);display:inline-flex;align-items:center;justify-content:center;font-size:26px;margin-bottom:14px;}
</style>

<div class="chat-wrap">
  <div class="chat-main">
    <div class="chat-header">
      <div class="ai-avatar">🤖</div>
      <div>
        <div style="font-size:14.5px;font-weight:800;color:#0F172A;">AI Campus Assistant</div>
        <div style="font-size:11.5px;color:#0D9069;display:flex;align-items:center;gap:5px;">
          <span style="width:7px;height:7px;background:#0D9069;border-radius:50%;display:inline-block;"></span>
          Online · Powered by Gemini AI
        </div>
      </div>
    </div>

    <div class="chat-messages" id="chatMessages">
      @if (!history.Any())
      {
        <div class="welcome-msg">
          <div class="ai-big">🤖</div>
          <div style="font-size:17px;font-weight:800;color:#0F172A;margin-bottom:8px;">How can I help you?</div>
          <div style="font-size:13px;line-height:1.65;">Ask me anything about your courses, grades, schedules, or any campus-related question.</div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:16px;">
            @foreach (var s in new[]{"What is my attendance?","When are exams?","How to submit assignment?","Check my grades"})
            {
              <button onclick="setQ('@s')" style="padding:7px 13px;background:#EFF6FF;border:1px solid #BFDBFE;color:#1A6FD4;border-radius:20px;font-size:12px;font-weight:600;cursor:pointer;font-family:'Inter',sans-serif;transition:.15s;">
                @s
              </button>
            }
          </div>
        </div>
      }

      @foreach (var q in history.OrderBy(h=>h.CreatedAt))
      {
        <!-- User message -->
        <div class="msg user">
          <div class="msg-avatar">U</div>
          <div>
            <div class="msg-bubble">@q.Question</div>
            <div class="msg-time" style="text-align:right;">@q.CreatedAt.ToString("HH:mm")</div>
          </div>
        </div>
        <!-- AI message -->
        <div class="msg ai">
          <div class="msg-avatar">🤖</div>
          <div>
            <div class="msg-bubble">
              @if (q.Answer.StartsWith("📋"))
              {
                <span style="font-size:10.5px;background:#D1FAE5;color:#065F46;padding:2px 8px;border-radius:10px;font-weight:700;display:inline-block;margin-bottom:5px;">✅ FAQ Answer</span><br/>
              }
              @(q.Answer.StartsWith("📋") ? q.Answer.Substring(q.Answer.IndexOf('\n') > 0 ? q.Answer.IndexOf('\n') + 1 : 3).TrimStart() : q.Answer)
            </div>
            <div class="msg-time">@q.CreatedAt.ToString("HH:mm")</div>
          </div>
        </div>
      }

      @if (ViewBag.Thinking == true)
      {
        <div class="msg ai">
          <div class="msg-avatar">🤖</div>
          <div class="msg-bubble" style="background:#F0F7FF;">
            <span style="display:inline-flex;gap:4px;align-items:center;">
              <span style="width:7px;height:7px;background:#1A6FD4;border-radius:50%;animation:pulse 1s infinite;"></span>
              <span style="width:7px;height:7px;background:#1A6FD4;border-radius:50%;animation:pulse 1s .2s infinite;"></span>
              <span style="width:7px;height:7px;background:#1A6FD4;border-radius:50%;animation:pulse 1s .4s infinite;"></span>
            </span>
          </div>
        </div>
      }
    </div>

    <div class="chat-input">
      <form method="post" action="/Teacher/Chat" id="chatForm" style="display:flex;gap:10px;flex:1;align-items:flex-end;">
        @Html.AntiForgeryToken()
        <textarea name="question" id="chatInput" placeholder="Type your question..." rows="1"
                  onkeydown="handleKey(event)" oninput="autoResize(this)"></textarea>
        <button type="submit" class="send-btn" onclick="showTyping()">
          <i class="bi bi-send-fill"></i>
        </button>
      </form>
    </div>
  </div>

  <!-- FAQ Sidebar -->
  <div class="sidebar-panel">
    <div class="faq-card">
      <div class="faq-card-header"><i class="bi bi-question-circle-fill" style="color:#1A6FD4;"></i> Quick FAQs</div>
      @foreach (var f in faqs.Take(8))
      {
        <div class="faq-item" onclick="setQ('@f.Question.Replace("'","\'")' )">
          <div class="faq-q">@f.Question</div>
          <div class="faq-a">@(f.Answer.Length>60?f.Answer.Substring(0,60)+"…":f.Answer)</div>
        </div>
      }
      @if (!faqs.Any())
      {
        <div style="padding:14px;font-size:12.5px;color:#94A3B8;text-align:center;">No FAQs available</div>
      }
    </div>

    <div class="faq-card">
      <div class="faq-card-header"><i class="bi bi-lightbulb-fill" style="color:#D97706;"></i> Tips</div>
      <div style="padding:12px 14px;font-size:12.5px;color:#64748B;line-height:1.6;">
        • Ask in English or Urdu<br/>
        • Be specific for better answers<br/>
        • Ask about grades, attendance<br/>
        • Ask about campus policies
      </div>
    </div>
  </div>
</div>

<script>
// Auto-scroll to bottom
const msgs = document.getElementById('chatMessages');
if(msgs) msgs.scrollTop = msgs.scrollHeight;

function setQ(q) {
  document.getElementById('chatInput').value = q;
  document.getElementById('chatInput').focus();
}

function handleKey(e) {
  if(e.key==='Enter' && !e.shiftKey) {
    e.preventDefault();
    document.getElementById('chatForm').submit();
  }
}

function autoResize(el) {
  el.style.height = 'auto';
  el.style.height = Math.min(el.scrollHeight, 100) + 'px';
}

function showTyping() {
  const input = document.getElementById('chatInput');
  if(!input.value.trim()) return;
}
</script>
