@model AI_Campus_Assistant.Models.User
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "My Profile";
}

<div style="display:grid;grid-template-columns:300px 1fr;gap:20px;align-items:start;">

  <!-- Profile Card -->
  <div class="card" style="text-align:center;">
    <div class="card-body">
      <div style="width:80px;height:80px;border-radius:20px;background:linear-gradient(135deg,#1A6FD4,#60A5FA);color:#fff;font-size:30px;font-weight:900;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;">
        @Model.Name.Substring(0,1).ToUpper()
      </div>
      <div style="font-size:18px;font-weight:800;color:#0F172A;">@Model.Name</div>
      <div style="font-size:13px;color:#64748B;margin-top:3px;">@Model.Email</div>
      <div style="margin:12px 0;display:flex;justify-content:center;gap:7px;flex-wrap:wrap;">
        <span class="badge badge-info">Student</span>
        @if(!string.IsNullOrEmpty(Model.Program)){<span class="badge badge-purple">@Model.Program</span>}
        @if(Model.SemesterNo>0){<span class="badge badge-success">Semester @Model.SemesterNo</span>}
        @if(Model.IsActive){<span class="badge badge-success">Active</span>}
      </div>
      @if (!string.IsNullOrEmpty(Model.Bio))
      {
        <div style="font-size:12.5px;color:#64748B;line-height:1.65;background:#F8FAFC;border-radius:9px;padding:10px;margin-top:10px;text-align:left;">@Model.Bio</div>
      }
      <div style="margin-top:14px;display:flex;flex-direction:column;gap:7px;text-align:left;">
        @if (!string.IsNullOrEmpty(Model.Phone))
        {
          <div style="font-size:13px;color:#475569;display:flex;align-items:center;gap:7px;">
            <i class="bi bi-telephone-fill" style="color:#1A6FD4;"></i>@Model.Phone
          </div>
        }
        <div style="font-size:13px;color:#475569;display:flex;align-items:center;gap:7px;">
          <i class="bi bi-calendar3" style="color:#1A6FD4;"></i>Joined @Model.CreatedAt.ToString("MMM yyyy")
        </div>
      </div>
    </div>
  </div>

  <!-- Edit Forms -->
  <div style="display:flex;flex-direction:column;gap:18px;">
    <!-- Update Profile -->
    <div class="card">
      <div class="card-header">
        <span class="card-title"><i class="bi bi-person-fill" style="color:#1A6FD4;margin-right:6px;"></i>Update Profile</span>
      </div>
      <div class="card-body">
        <form method="post" action="/Student/UpdateProfile">
          @Html.AntiForgeryToken()
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label">Full Name *</label>
              <input type="text" name="name" class="form-control" value="@Model.Name" required/>
            </div>
            <div class="form-group">
              <label class="form-label">Phone</label>
              <input type="tel" name="phone" class="form-control" value="@Model.Phone" placeholder="+92 300 0000000"/>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">Bio</label>
            <textarea name="bio" class="form-control" rows="3" placeholder="Write something about yourself..." style="resize:vertical;">@Model.Bio</textarea>
          </div>
          <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
        </form>
      </div>
    </div>

    <!-- Change Password -->
    <div class="card">
      <div class="card-header">
        <span class="card-title"><i class="bi bi-lock-fill" style="color:#6C63FF;margin-right:6px;"></i>Change Password</span>
      </div>
      <div class="card-body">
        <form method="post" action="/Student/ChangePassword">
          @Html.AntiForgeryToken()
          <div class="form-group">
            <label class="form-label">Current Password *</label>
            <input type="password" name="currentPassword" class="form-control" placeholder="Enter current password" required/>
          </div>
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label">New Password *</label>
              <input type="password" name="newPassword" class="form-control" placeholder="Min 6 characters" required
                     oninput="checkPasswordStrength(this.value,'spwFill','spwLbl')"/>
              <div style="height:4px;background:#E2E8F0;border-radius:4px;overflow:hidden;margin-top:5px;">
                <div id="spwFill" style="height:100%;width:0;border-radius:4px;transition:.3s;"></div>
              </div>
              <div id="spwLbl" style="font-size:10.5px;margin-top:3px;color:#9CA3AF;"></div>
            </div>
            <div class="form-group">
              <label class="form-label">Confirm Password *</label>
              <input type="password" name="confirmPassword" class="form-control" placeholder="Re-enter new password" required/>
            </div>
          </div>
          <button type="submit" class="btn btn-primary" style="background:linear-gradient(135deg,#6C63FF,#4B44CC);">
            <i class="bi bi-shield-lock-fill"></i> Update Password
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
<script src="/js/site.js"></script>
