@model List<AI_Campus_Assistant.Models.Notification>
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Notifications";
}

<div class="card">
  <div class="card-header">
    <span class="card-title"><i class="bi bi-bell-fill" style="color:#1A6FD4;margin-right:6px;"></i>All Notifications (@Model.Count)</span>
  </div>
  <div style="display:flex;flex-direction:column;gap:0;">
    @foreach (var n in Model)
    {
      var (ic,cl,bg,bd) = n.Type switch {
        "success" => ("check-circle-fill","#065F46","#ECFDF5","#A7F3D0"),
        "warning" => ("exclamation-triangle-fill","#92400E","#FFFBEB","#FDE68A"),
        "danger"  => ("x-circle-fill","#9F1239","#FFF1F2","#FCA5A5"),
        _         => ("info-circle-fill","#1E40AF","#EFF6FF","#BFDBFE")
      };
      <div style="padding:16px 20px;border-bottom:1px solid #F1F5F9;display:flex;gap:14px;align-items:flex-start;transition:.15s;"
           onmouseover="this.style.background='#FAFBFF'" onmouseout="this.style.background=''">
        <div style="width:42px;height:42px;border-radius:11px;background:@bg;border:1px solid @bd;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <i class="bi bi-@ic" style="color:@cl;font-size:18px;"></i>
        </div>
        <div style="flex:1;">
          <div style="font-size:14.5px;font-weight:700;color:#0F172A;margin-bottom:4px;">@n.Title</div>
          <div style="font-size:13px;color:#475569;line-height:1.6;">@n.Message</div>
          <div style="font-size:11.5px;color:#94A3B8;margin-top:6px;display:flex;gap:10px;">
            <span><i class="bi bi-clock"></i> @n.CreatedAt.ToString("MMM dd, yyyy  HH:mm")</span>
            <span class="badge @(n.TargetRole=="all"?"badge-purple":n.TargetRole=="student"?"badge-info":"badge-success")" style="font-size:10px;">
              @(n.TargetRole=="all"?"Everyone":n.TargetRole=="student"?"Students":"Teachers")
            </span>
          </div>
        </div>
      </div>
    }
    @if (!Model.Any())
    {
      <div class="empty-state"><i class="bi bi-bell-slash"></i><h4>No Notifications</h4><p>You have no notifications at this time.</p></div>
    }
  </div>
</div>
