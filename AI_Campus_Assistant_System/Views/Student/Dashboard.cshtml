@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Dashboard";
    var user        = ViewBag.User as AI_Campus_Assistant.Models.User;
    var grades      = ViewBag.Grades      as List<AI_Campus_Assistant.Models.Grade>        ?? new();
    var attendance  = ViewBag.Attendance  as List<AI_Campus_Assistant.Models.Attendance>   ?? new();
    var assignments = ViewBag.Assignments as List<AI_Campus_Assistant.Models.Assignment>   ?? new();
    var notifs      = ViewBag.Notifications as List<AI_Campus_Assistant.Models.Notification> ?? new();

    var totalAtt  = attendance.Count;
    var present   = attendance.Count(a => a.Status == "present");
    var attPct    = totalAtt > 0 ? (double)present / totalAtt * 100 : 0;
    var avgGrade  = grades.Any() ? grades.Average(g => g.TotalMarks) : 0;
    var dueAsn    = assignments.Count(a => a.DueDate >= DateTime.Today);
}

<!-- Welcome Banner -->
<div style="background:linear-gradient(135deg,#0B1E3E 0%,#1A6FD4 100%);border-radius:16px;padding:24px 28px;margin-bottom:22px;display:flex;align-items:center;justify-content:space-between;overflow:hidden;position:relative;">
  <div style="position:absolute;width:300px;height:300px;border-radius:50%;background:rgba(255,255,255,.05);top:-100px;right:-50px;"></div>
  <div style="position:relative;z-index:1;">
    <div style="color:rgba(255,255,255,.65);font-size:13px;font-weight:600;margin-bottom:4px;">Welcome back 👋</div>
    <div style="color:#fff;font-size:22px;font-weight:800;margin-bottom:6px;">@(user?.Name ?? "Student")</div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      @if(!string.IsNullOrEmpty(user?.Program)){
        <span style="background:rgba(255,255,255,.15);color:#fff;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;">@user.Program</span>
      }
      @if(user?.SemesterNo > 0){
        <span style="background:rgba(96,165,250,.3);color:#BFDBFE;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;">Semester @user.SemesterNo</span>
      }
    </div>
  </div>
  <div style="position:relative;z-index:1;text-align:right;">
    <div style="color:rgba(255,255,255,.5);font-size:11px;text-transform:uppercase;letter-spacing:.5px;">Today</div>
    <div style="color:#fff;font-size:15px;font-weight:700;">@DateTime.Now.ToString("dddd, MMM dd")</div>
  </div>
</div>

<!-- Stats -->
<div class="stat-grid">
  <div class="stat-card">
    <div class="sc-icon sci-green"><i class="bi bi-calendar-check-fill"></i></div>
    <div>
      <div class="sc-val">@attPct.ToString("F0")%</div>
      <div class="sc-lbl">Attendance</div>
      <div style="font-size:11px;color:@(attPct>=75?"#0D9069":"#E11D48");font-weight:600;margin-top:2px;">
        @(attPct>=75?"✓ Good Standing":"⚠ Below 75%")
      </div>
    </div>
  </div>
  <div class="stat-card">
    <div class="sc-icon sci-blue"><i class="bi bi-bar-chart-fill"></i></div>
    <div>
      <div class="sc-val">@avgGrade.ToString("F0")</div>
      <div class="sc-lbl">Avg Grade</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="sc-icon sci-amber"><i class="bi bi-pencil-square"></i></div>
    <div>
      <div class="sc-val" data-count="@dueAsn">0</div>
      <div class="sc-lbl">Due Assignments</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="sc-icon sci-purple"><i class="bi bi-book-fill"></i></div>
    <div>
      <div class="sc-val" data-count="@grades.Count">0</div>
      <div class="sc-lbl">Enrolled Courses</div>
    </div>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;">

  <!-- Grades Summary -->
  <div class="card">
    <div class="card-header">
      <span class="card-title"><i class="bi bi-bar-chart-fill" style="color:#1A6FD4;margin-right:6px;"></i>My Grades</span>
      <a href="/Student/Grades" class="btn btn-secondary btn-sm">View All</a>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Course</th><th>Marks</th><th>Grade</th></tr></thead>
        <tbody>
          @foreach (var g in grades.Take(4))
          {
            var gc = g.GradeLetter.StartsWith("A") ? "#0D9069" : g.GradeLetter.StartsWith("B") ? "#1A6FD4" : g.GradeLetter.StartsWith("C") ? "#D97706" : "#E11D48";
            <tr>
              <td style="font-size:13px;font-weight:600;">@g.CourseName</td>
              <td>
                <div style="display:flex;align-items:center;gap:8px;">
                  <div style="flex:1;height:6px;background:#E2E8F0;border-radius:99px;overflow:hidden;">
                    <div style="height:100%;width:@(g.TotalMarks)%;background:@gc;border-radius:99px;"></div>
                  </div>
                  <span style="font-size:12px;font-weight:700;color:#0F172A;">@g.TotalMarks</span>
                </div>
              </td>
              <td><span style="font-weight:800;color:@gc;">@g.GradeLetter</span></td>
            </tr>
          }
          @if (!grades.Any())
          { <tr><td colspan="3" style="text-align:center;padding:20px;color:#94A3B8;font-size:13px;">No grades yet</td></tr> }
        </tbody>
      </table>
    </div>
  </div>

  <!-- Assignments -->
  <div class="card">
    <div class="card-header">
      <span class="card-title"><i class="bi bi-pencil-square" style="color:#D97706;margin-right:6px;"></i>Upcoming Assignments</span>
      <a href="/Student/Assignments" class="btn btn-secondary btn-sm">View All</a>
    </div>
    <div class="card-body" style="padding:0;">
      @foreach (var a in assignments.Where(x=>x.DueDate>=DateTime.Today).Take(4))
      {
        var daysLeft = (a.DueDate - DateTime.Today).Days;
        var urgency  = daysLeft <= 1 ? "#EF4444" : daysLeft <= 3 ? "#D97706" : "#0D9069";
        <div style="padding:12px 18px;border-bottom:1px solid #F1F5F9;display:flex;align-items:center;justify-content:space-between;">
          <div>
            <div style="font-weight:700;font-size:13.5px;color:#0F172A;">@a.Title</div>
            <div style="font-size:11.5px;color:#94A3B8;">@a.CourseName</div>
          </div>
          <div style="text-align:right;">
            <div style="font-size:11.5px;font-weight:700;color:@urgency;">
              @(daysLeft == 0 ? "Due Today!" : daysLeft == 1 ? "Tomorrow" : $"{daysLeft} days")
            </div>
            <div style="font-size:10.5px;color:#94A3B8;">@a.DueDate.ToString("MMM dd")</div>
          </div>
        </div>
      }
      @if (!assignments.Any(x=>x.DueDate>=DateTime.Today))
      {
        <div style="padding:24px;text-align:center;color:#94A3B8;font-size:13px;">
          <i class="bi bi-check-circle-fill" style="font-size:24px;color:#0D9069;display:block;margin-bottom:6px;"></i>
          No pending assignments!
        </div>
      }
    </div>
  </div>

  <!-- Attendance Chart -->
  <div class="card">
    <div class="card-header">
      <span class="card-title"><i class="bi bi-calendar-check-fill" style="color:#0D9069;margin-right:6px;"></i>Attendance Overview</span>
      <a href="/Student/Attendance" class="btn btn-secondary btn-sm">Details</a>
    </div>
    <div class="card-body">
      <div style="display:flex;align-items:center;gap:20px;">
        <!-- Circle -->
        <div style="position:relative;width:90px;height:90px;flex-shrink:0;">
          <svg viewBox="0 0 36 36" style="width:90px;height:90px;transform:rotate(-90deg);">
            <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#E2E8F0" stroke-width="3"/>
            <circle cx="18" cy="18" r="15.9155" fill="none"
                    stroke="@(attPct>=75?"#0D9069":"#E11D48")"
                    stroke-width="3"
                    stroke-dasharray="@(attPct) @(100-attPct)"
                    stroke-linecap="round"/>
          </svg>
          <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;color:#0F172A;">@attPct.ToString("F0")%</div>
        </div>
        <div style="flex:1;">
          <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
            <span style="font-size:13px;color:#64748B;">Present</span>
            <span style="font-size:13px;font-weight:700;color:#0D9069;">@present</span>
          </div>
          <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
            <span style="font-size:13px;color:#64748B;">Absent</span>
            <span style="font-size:13px;font-weight:700;color:#E11D48;">@attendance.Count(a=>a.Status=="absent")</span>
          </div>
          <div style="display:flex;justify-content:space-between;">
            <span style="font-size:13px;color:#64748B;">Late</span>
            <span style="font-size:13px;font-weight:700;color:#D97706;">@attendance.Count(a=>a.Status=="late")</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Notifications -->
  <div class="card">
    <div class="card-header">
      <span class="card-title"><i class="bi bi-bell-fill" style="color:#6C63FF;margin-right:6px;"></i>Notifications</span>
      <a href="/Student/Notifications" class="btn btn-secondary btn-sm">View All</a>
    </div>
    <div class="card-body" style="padding:0;">
      @foreach (var n in notifs.Take(4))
      {
        var ic = n.Type=="success"?"check-circle-fill":n.Type=="warning"?"exclamation-triangle-fill":n.Type=="danger"?"x-circle-fill":"info-circle-fill";
        var cl = n.Type=="success"?"#0D9069":n.Type=="warning"?"#D97706":n.Type=="danger"?"#E11D48":"#1A6FD4";
        <div style="padding:11px 16px;border-bottom:1px solid #F1F5F9;display:flex;gap:10px;align-items:flex-start;">
          <i class="bi bi-@ic" style="color:@cl;font-size:15px;margin-top:1px;flex-shrink:0;"></i>
          <div>
            <div style="font-size:13.5px;font-weight:600;color:#0F172A;">@n.Title</div>
            <div style="font-size:11.5px;color:#94A3B8;">@n.CreatedAt.ToString("MMM dd")</div>
          </div>
        </div>
      }
      @if (!notifs.Any())
      {
        <div style="padding:24px;text-align:center;color:#94A3B8;font-size:13px;">No notifications</div>
      }
    </div>
  </div>

</div>

<!-- Quick Actions -->
<div class="card" style="margin-top:18px;">
  <div class="card-header">
    <span class="card-title"><i class="bi bi-lightning-fill" style="color:#D97706;margin-right:6px;"></i>Quick Actions</span>
  </div>
  <div class="card-body" style="display:flex;gap:12px;flex-wrap:wrap;">
    <a href="/Student/Chat"        class="btn btn-primary"><i class="bi bi-robot"></i> Ask AI</a>
    <a href="/Student/Timetable"   class="btn btn-secondary"><i class="bi bi-clock-fill"></i> Timetable</a>
    <a href="/Student/Grades"      class="btn btn-secondary"><i class="bi bi-bar-chart-fill"></i> Grades</a>
    <a href="/Student/Assignments" class="btn btn-secondary"><i class="bi bi-pencil-square"></i> Assignments</a>
    <a href="/Student/Complaints"  class="btn btn-secondary"><i class="bi bi-chat-left-text-fill"></i> File Complaint</a>
  </div>
</div>
<script src="/js/site.js"></script>
