@model List<AI_Campus_Assistant.Models.Lecture>
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Lectures";
    var user = ViewBag.User as AI_Campus_Assistant.Models.User;

    // Group lectures by course
    var byCourse = Model.GroupBy(l => l.CourseName).OrderBy(g => g.Key).ToList();
}

<!-- Stats -->
<div class="stat-grid" style="grid-template-columns:repeat(auto-fit,minmax(175px,1fr));margin-bottom:22px;">
    <div class="stat-card">
        <div class="sc-icon sci-blue"><i class="bi bi-collection-fill"></i></div>
        <div>
            <div class="sc-val" data-count="@Model.Count">0</div>
            <div class="sc-lbl">Total Lectures</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="sc-icon sci-purple"><i class="bi bi-journal-bookmark-fill"></i></div>
        <div>
            <div class="sc-val" data-count="@byCourse.Count">0</div>
            <div class="sc-lbl">Courses</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="sc-icon sci-teal"><i class="bi bi-file-earmark-pdf-fill"></i></div>
        <div>
            <div class="sc-val" data-count="@Model.Count(l => l.FileType == "pdf")">0</div>
            <div class="sc-lbl">PDF Files</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="sc-icon sci-amber"><i class="bi bi-file-earmark-slides-fill"></i></div>
        <div>
            <div class="sc-val" data-count="@Model.Count(l => l.FileType == "pptx" || l.FileType == "ppt")">0</div>
            <div class="sc-lbl">Presentations</div>
        </div>
    </div>
</div>

@if (user != null)
{
    <div class="alert alert-info" style="margin-bottom:18px;">
        <i class="bi bi-info-circle-fill"></i>
        Showing lectures for <strong>@user.Program</strong> — Semester <strong>@user.SemesterNo</strong>.
        Download any material for offline study.
    </div>
}

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="empty-state">
                <i class="bi bi-collection"></i>
                <h4>No Lectures Available</h4>
                <p>Your teachers haven't uploaded any lecture materials yet. Check back later.</p>
            </div>
        </div>
    </div>
}
else
{
    <!-- Search bar -->
    <div style="margin-bottom:16px;display:flex;gap:10px;align-items:center;">
        <div style="position:relative;flex:1;max-width:340px;">
            <i class="bi bi-search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#94A3B8;font-size:14px;"></i>
            <input type="text" id="lectureSearch" placeholder="Search lectures or courses…"
                   class="form-control" style="padding-left:36px;"
                   oninput="filterLectures(this.value)" />
        </div>
        <select id="courseFilter" class="form-control" style="width:200px;" onchange="filterLectures(document.getElementById('lectureSearch').value)">
            <option value="">All Courses</option>
            @foreach (var g in byCourse)
            {
                <option value="@g.Key">@g.Key</option>
            }
        </select>
    </div>

    <!-- Lectures grouped by course -->
    <div id="lecturesContainer">
        @foreach (var group in byCourse)
        {
            <div class="card lecture-group" data-course="@group.Key" style="margin-bottom:18px;">
                <div class="card-header" style="cursor:pointer;" onclick="toggleGroup(this)">
                    <span class="card-title">
                        <i class="bi bi-journal-bookmark-fill" style="color:#1A6FD4;margin-right:7px;"></i>
                        @group.Key
                    </span>
                    <div style="display:flex;align-items:center;gap:10px;">
                        <span class="badge badge-info">@group.Count() lecture@(group.Count() != 1 ? "s" : "")</span>
                        <i class="bi bi-chevron-down toggle-icon" style="color:#94A3B8;font-size:13px;transition:.2s;"></i>
                    </div>
                </div>
                <div class="table-wrap group-body">
                    <table>
                        <thead>
                            <tr>
                                <th>Week</th>
                                <th>Title</th>
                                <th>Description</th>
                                <th>Teacher</th>
                                <th>File</th>
                                <th>Size</th>
                                <th>Uploaded</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lec in group.OrderBy(l => l.WeekNo))
                            {
                                var icon = lec.FileType switch
                                {
                                    "pdf" => "bi-file-earmark-pdf-fill",
                                    "pptx" or "ppt" => "bi-file-earmark-slides-fill",
                                    "docx" or "doc" => "bi-file-earmark-word-fill",
                                    "xlsx" or "xls" => "bi-file-earmark-excel-fill",
                                    _ => "bi-file-earmark-fill"
                                };
                                var iconColor = lec.FileType switch
                                {
                                    "pdf" => "#E11D48",
                                    "pptx" or "ppt" => "#D97706",
                                    "docx" or "doc" => "#1A6FD4",
                                    "xlsx" or "xls" => "#0D9069",
                                    _ => "#64748B"
                                };
                                var sizeMb = lec.FileSize > 0 ? (lec.FileSize / 1024.0 / 1024.0).ToString("F1") + " MB" : "—";

                                <tr class="lecture-row" data-title="@lec.Title.ToLower()" data-course="@lec.CourseName">
                                    <td>
                                        <span class="badge badge-info" style="font-size:11px;">Wk @lec.WeekNo</span>
                                    </td>
                                    <td>
                                        <div style="font-weight:700;font-size:13px;color:#0F172A;">@lec.Title</div>
                                    </td>
                                    <td style="max-width:220px;">
                                        @if (!string.IsNullOrWhiteSpace(lec.Description))
                                        {
                                            <div style="font-size:12px;color:#64748B;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:200px;"
                                                 title="@lec.Description">
                                                @lec.Description
                                            </div>
                                        }
                                        else
                                        {
                                            <span style="color:#CBD5E1;font-size:12px;">—</span>
                                        }
                                    </td>
                                    <td>
                                        <div style="font-size:12.5px;font-weight:600;">@lec.TeacherName</div>
                                    </td>
                                    <td>
                                        <div style="display:flex;align-items:center;gap:6px;">
                                            <i class="bi @icon" style="color:@iconColor;font-size:16px;"></i>
                                            <span style="font-size:11.5px;color:#64748B;text-transform:uppercase;font-weight:700;">
                                                @lec.FileType
                                            </span>
                                        </div>
                                    </td>
                                    <td style="font-size:12px;color:#94A3B8;">@sizeMb</td>
                                    <td style="font-size:12px;color:#64748B;">
                                        @lec.CreatedAt.ToString("dd MMM yyyy")
                                    </td>
                                    <td>
                                        <a href="/Student/DownloadLecture/@lec.Id" class="btn btn-primary btn-sm" title="Download @lec.FileName">
                                            <i class="bi bi-download"></i> Download
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- No results message (hidden by default) -->
    <div id="noResults" style="display:none;">
        <div class="card">
            <div class="card-body">
                <div class="empty-state">
                    <i class="bi bi-search"></i>
                    <h4>No Results Found</h4>
                    <p>Try a different search term or clear the filter.</p>
                </div>
            </div>
        </div>
    </div>
}

<script>
    function toggleGroup(header) {
        var body = header.nextElementSibling;
        var icon = header.querySelector('.toggle-icon');
        if (body.style.display === 'none') {
            body.style.display = '';
            icon.style.transform = 'rotate(0deg)';
        } else {
            body.style.display = 'none';
            icon.style.transform = 'rotate(-90deg)';
        }
    }

    function filterLectures(query) {
        var q = query.toLowerCase().trim();
        var courseFilter = document.getElementById('courseFilter').value;
        var groups = document.querySelectorAll('.lecture-group');
        var anyVisible = false;

        groups.forEach(function (group) {
            var courseName = group.getAttribute('data-course');
            var courseMatch = !courseFilter || courseName === courseFilter;

            if (!courseMatch) {
                group.style.display = 'none';
                return;
            }

            var rows = group.querySelectorAll('.lecture-row');
            var groupVisible = false;

            rows.forEach(function (row) {
                var title = row.getAttribute('data-title') || '';
                var visible = !q || title.includes(q) || courseName.toLowerCase().includes(q);
                row.style.display = visible ? '' : 'none';
                if (visible) groupVisible = true;
            });

            group.style.display = groupVisible ? '' : 'none';
            if (groupVisible) {
                anyVisible = true;
                // Expand group if there's a search query
                if (q) {
                    var body = group.querySelector('.group-body');
                    var icon = group.querySelector('.toggle-icon');
                    if (body) body.style.display = '';
                    if (icon) icon.style.transform = 'rotate(0deg)';
                }
            }
        });

        document.getElementById('noResults').style.display = anyVisible ? 'none' : 'block';
    }
</script>
