@model List<AI_Campus_Assistant.Models.Assignment>
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Assignments";
    var submittedMap = ViewBag.SubmittedMap as Dictionary<string, AI_Campus_Assistant.Models.AssignmentSubmission>
                       ?? new();
    var due     = Model.Count(a => a.DueDate >= DateTime.Today);
    var overdue = Model.Count(a => a.DueDate < DateTime.Today);
    var submitted = submittedMap.Count;
}

<div class="stat-grid" style="grid-template-columns:repeat(4,1fr);margin-bottom:20px;">
  <div class="stat-card"><div class="sc-icon sci-blue"><i class="bi bi-collection-fill"></i></div><div><div class="sc-val" data-count="@Model.Count">0</div><div class="sc-lbl">Total</div></div></div>
  <div class="stat-card"><div class="sc-icon sci-amber"><i class="bi bi-pencil-square"></i></div><div><div class="sc-val" data-count="@due">0</div><div class="sc-lbl">Due</div></div></div>
  <div class="stat-card"><div class="sc-icon sci-green"><i class="bi bi-check-circle-fill"></i></div><div><div class="sc-val" data-count="@submitted">0</div><div class="sc-lbl">Submitted</div></div></div>
  <div class="stat-card"><div class="sc-icon sci-red"><i class="bi bi-exclamation-triangle-fill"></i></div><div><div class="sc-val" data-count="@overdue">0</div><div class="sc-lbl">Overdue</div></div></div>
</div>

<div class="card">
  <div class="card-header">
    <span class="card-title"><i class="bi bi-pencil-square" style="color:#D97706;margin-right:6px;"></i>All Assignments</span>
  </div>
  <div style="padding:14px 18px;display:flex;flex-direction:column;gap:12px;">
    @foreach (var a in Model.OrderBy(x => x.DueDate))
    {
      var daysLeft = (a.DueDate - DateTime.Today).Days;
      var isOver   = daysLeft < 0;
      var urgColor = isOver ? "#E11D48" : daysLeft == 0 ? "#E11D48" : daysLeft <= 2 ? "#D97706" : "#0D9069";
      var sub      = submittedMap.ContainsKey(a.Id!) ? submittedMap[a.Id!] : null;
      var isSubmitted = sub != null;

      <div style="background:#F8FAFC;border:1.5px solid @(isSubmitted?"#0D9069":isOver?"#FCA5A5":"#E2E8F0");border-radius:13px;padding:16px;position:relative;overflow:hidden;">
        @if (isSubmitted)
        { <div style="position:absolute;top:0;right:0;background:#0D9069;color:#fff;font-size:10px;font-weight:700;padding:3px 10px;border-radius:0 13px 0 9px;">SUBMITTED</div> }

        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:14px;">
          <div style="flex:1;">
            <div style="font-size:15px;font-weight:800;color:#0F172A;margin-bottom:4px;">@a.Title</div>
            @if (!string.IsNullOrEmpty(a.Description))
            { <div style="font-size:12.5px;color:#64748B;margin-bottom:8px;line-height:1.5;">@a.Description</div> }

            <div style="display:flex;gap:7px;flex-wrap:wrap;align-items:center;margin-bottom:8px;">
              <span class="badge badge-info"><i class="bi bi-book-fill"></i> @a.CourseName</span>
              <span class="badge badge-purple"><i class="bi bi-award-fill"></i> @a.TotalMarks Marks</span>
              <span style="background:#FFF7ED;color:@urgColor;font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;border:1px solid @urgColor;">
                <i class="bi bi-calendar3"></i> @a.DueDate.ToString("dd MMM yyyy")
              </span>
              @if (!string.IsNullOrEmpty(a.FilePath))
              {
                <a href="/Student/DownloadAssignment/@a.Id" class="badge badge-warning" style="text-decoration:none;cursor:pointer;">
                  <i class="bi bi-file-earmark-arrow-down-fill"></i> Download Question
                </a>
              }
            </div>

            <!-- Grade result if graded -->
            @if (isSubmitted && sub!.IsGraded)
            {
              var gc = sub.ObtainedMarks >= sub.TotalMarks * 0.85 ? "#0D9069"
                     : sub.ObtainedMarks >= sub.TotalMarks * 0.6  ? "#1A6FD4"
                     : sub.ObtainedMarks >= sub.TotalMarks * 0.5  ? "#D97706" : "#E11D48";
              <div style="background:#ECFDF5;border:1.5px solid #6EE7B7;border-radius:10px;padding:10px 14px;margin-top:6px;">
                <div style="font-size:11px;color:#64748B;font-weight:700;margin-bottom:4px;"><i class="bi bi-award-fill" style="color:#0D9069;"></i> GRADE RESULT</div>
                <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                  <div>
                    <span style="font-size:22px;font-weight:900;color:@gc;">@sub.ObtainedMarks</span>
                    <span style="font-size:14px;color:#64748B;"> / @sub.TotalMarks</span>
                  </div>
                  <div style="flex:1;min-width:80px;">
                    <div style="height:6px;background:#E2E8F0;border-radius:99px;overflow:hidden;">
                      <div style="height:100%;width:@((sub.ObtainedMarks??0)/sub.TotalMarks*100)%;background:@gc;border-radius:99px;"></div>
                    </div>
                  </div>
                  @if (!string.IsNullOrEmpty(sub.Feedback))
                  { <div style="font-size:12px;color:#065F46;font-style:italic;flex:1;min-width:120px;"><i class="bi bi-chat-quote-fill"></i> @sub.Feedback</div> }
                </div>
              </div>
            }
            else if (isSubmitted)
            {
              <div style="background:#FFFBEB;border:1px solid #FDE68A;border-radius:9px;padding:8px 12px;margin-top:6px;font-size:12.5px;color:#92400E;">
                <i class="bi bi-clock-fill"></i> Submitted — Awaiting grading from teacher
              </div>
            }
          </div>

          <!-- Action -->
          <div style="text-align:right;flex-shrink:0;">
            <div style="font-size:12px;font-weight:800;color:@urgColor;margin-bottom:8px;">
              @(isOver ? "Closed" : daysLeft == 0 ? "Due Today!" : daysLeft == 1 ? "1 day left" : $"{daysLeft} days left")
            </div>
            @if (isSubmitted)
            {
              <span class="badge badge-success" style="padding:6px 12px;"><i class="bi bi-check-circle-fill"></i> Submitted</span>
              @if (!string.IsNullOrEmpty(sub!.FilePath))
              {
                <br/><a href="/Student/DownloadMySubmission/@sub.Id" class="btn btn-secondary btn-sm" style="margin-top:6px;">
                  <i class="bi bi-download"></i> My File
                </a>
              }
            }
            else if (!isOver)
            {
              <button onclick="openModal('sub-@a.Id')" class="btn btn-primary btn-sm">
                <i class="bi bi-upload"></i> Submit
              </button>
            }
            else
            { <span class="badge badge-danger">Expired</span> }
          </div>
        </div>
      </div>

      <!-- Submit Modal -->
      @if (!isSubmitted && !isOver)
      {
        <div class="modal-backdrop" id="sub-@a.Id">
          <div class="modal" style="max-width:500px;">
            <div class="modal-title"><i class="bi bi-upload" style="color:#1A6FD4;margin-right:8px;"></i>Submit Assignment</div>
            <div style="background:#EFF6FF;border:1px solid #BFDBFE;border-radius:9px;padding:10px 13px;margin-bottom:14px;">
              <div style="font-weight:700;font-size:13.5px;">@a.Title</div>
              <div style="font-size:12px;color:#64748B;margin-top:2px;">Due: @a.DueDate.ToString("dd MMM yyyy") · @a.TotalMarks marks</div>
            </div>
            <form method="post" action="/Student/SubmitAssignment" enctype="multipart/form-data">
              @Html.AntiForgeryToken()
              <input type="hidden" name="assignmentId" value="@a.Id"/>
              <div class="form-group">
                <label class="form-label">Upload File <span style="color:#94A3B8;font-weight:400;">(PDF, DOCX, PPTX, XLSX)</span></label>
                <div style="border:2px dashed #BFDBFE;border-radius:9px;padding:16px;text-align:center;cursor:pointer;background:#F0F7FF;"
                     onclick="document.getElementById('sf-@a.Id').click()">
                  <i class="bi bi-cloud-upload" style="font-size:24px;color:#1A6FD4;display:block;margin-bottom:4px;"></i>
                  <div id="sfname-@a.Id" style="font-size:12.5px;color:#94A3B8;">Click to select file</div>
                </div>
                <input type="file" id="sf-@a.Id" name="submissionFile"
                       accept=".pdf,.docx,.doc,.pptx,.ppt,.xlsx,.xls" style="display:none;"
                       onchange="document.getElementById('sfname-@a.Id').textContent=this.files[0]?.name||'No file'"/>
              </div>
              <div class="form-group">
                <label class="form-label">Additional Notes <span style="color:#94A3B8;font-weight:400;">(optional)</span></label>
                <textarea name="content" class="form-control" rows="3" style="resize:vertical;"
                          placeholder="Write any notes or answers here..."></textarea>
              </div>
              <div class="modal-footer">
                <button type="button" onclick="closeModal('sub-@a.Id')" class="btn btn-secondary">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-send-fill"></i> Submit</button>
              </div>
            </form>
          </div>
        </div>
      }
    }
    @if (!Model.Any())
    { <div class="empty-state"><i class="bi bi-pencil"></i><h4>No Assignments</h4><p>Assignments posted by your teachers will appear here.</p></div> }
  </div>
</div>
