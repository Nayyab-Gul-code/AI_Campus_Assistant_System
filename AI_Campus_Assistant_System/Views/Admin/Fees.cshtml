@model List<AI_Campus_Assistant.Models.Fee>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    ViewData["Title"] = "Fee Management";

    var students = ViewBag.Students as List<AI_Campus_Assistant.Models.User> ?? new();

    var feeRequests = ViewBag.FeeRequests as List<AI_Campus_Assistant.Models.FeeRequest> ?? new();

    int pendingVer = (int)(ViewBag.PendingVerification ?? 0);
}

<!-- Stats -->
<div class="stat-grid" style="grid-template-columns:repeat(5,1fr);margin-bottom:20px;">
    <div class="stat-card">
        <div class="sc-icon sci-blue"><i class="bi bi-receipt"></i></div>
        <div><div class="sc-val" data-count="@Model.Count">0</div><div class="sc-lbl">Total Records</div></div>
    </div>
    <div class="stat-card">
        <div class="sc-icon sci-green"><i class="bi bi-check-circle-fill"></i></div>
        <div><div class="sc-val" style="font-size:17px;">PKR @(((double)ViewBag.PaidAmount).ToString("N0"))</div><div class="sc-lbl">Total Paid</div></div>
    </div>
    <div class="stat-card">
        <div class="sc-icon sci-red"><i class="bi bi-exclamation-circle-fill"></i></div>
        <div><div class="sc-val" style="font-size:17px;">PKR @(((double)ViewBag.UnpaidAmount).ToString("N0"))</div><div class="sc-lbl">Total Unpaid</div></div>
    </div>
    <div class="stat-card">
        <div class="sc-icon sci-amber"><i class="bi bi-hourglass-split"></i></div>
        <div><div class="sc-val" data-count="@pendingVer">0</div><div class="sc-lbl">Pending Verify</div></div>
    </div>
    <div class="stat-card">
        <div class="sc-icon sci-purple"><i class="bi bi-bell-fill"></i></div>
        <div><div class="sc-val" data-count="@feeRequests.Count">0</div><div class="sc-lbl">New Requests</div></div>
    </div>
</div>

<!-- ═══ STUDENT FEE REQUESTS (Admin must act on these) ═══ -->
@if (feeRequests.Any())

{
    <div class="card" style="margin-bottom:20px;border:2px solid #FDE68A;">
        <div class="card-header" style="background:#FFFBEB;">
            <span class="card-title" style="color:#92400E;">
                <i class="bi bi-bell-fill" style="color:#D97706;margin-right:7px;"></i>
                Student Fee Requests — Action Required (@feeRequests.Count)
            </span>
            <span class="badge badge-warning">Review & Generate Challans</span>
        </div>
        <div style="padding:16px;display:flex;flex-direction:column;gap:14px;">
            @foreach (var req in feeRequests)

            {
                <div style="border:1.5px solid #FDE68A;border-radius:12px;padding:16px;background:#fff;">
                    <!-- Student info header -->
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:14px;">
                        <div>
                            <div style="font-weight:800;font-size:14px;color:#0F172A;">@req.StudentName</div>
                            <div style="font-size:12px;color:#64748B;">@req.Program — Semester @req.SemesterNo</div>
                            <div style="font-size:11px;color:#94A3B8;margin-top:2px;">
                                Requested: @req.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                            </div>
                        </div>
                        <div style="display:flex;gap:8px;flex-wrap:wrap;">
                            @if (req.WantsTransport)
                            {
                                <span class="badge badge-info">🚌 Transport</span>
                            }
                            else
                            {
                                <span style="font-size:11px;color:#94A3B8;padding:3px 8px;border:1px solid #E2E8F0;border-radius:20px;">No Transport</span>
                            }

                            @if (req.WantsHostel)
                            {
                                <span class="badge badge-purple">🏠 Hostel</span>
                            }
                            else
                            {
                                <span style="font-size:11px;color:#94A3B8;padding:3px 8px;border:1px solid #E2E8F0;border-radius:20px;">No Hostel</span>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(req.StudentNote))

                    {
                        <div style="background:#F0F7FF;border:1px solid #BFDBFE;border-radius:8px;padding:9px 12px;margin-bottom:12px;font-size:12.5px;color:#1E40AF;">
                            <i class="bi bi-chat-quote-fill" style="margin-right:5px;"></i>
                            Student note: "<em>@req.StudentNote</em>"
                        </div>
                    }

                    <!-- Fee entry form -->
                    <form method="post" action="/Admin/CreateFeeFromRequest">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="requestId" value="@req.Id" />
                        <input type="hidden" name="studentId" value="@req.StudentId" />
                        <input type="hidden" name="hasTransport" value="@req.WantsTransport.ToString().ToLower()" />
                        <input type="hidden" name="hasHostel" value="@req.WantsHostel.ToString().ToLower()" />

                        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:12px;">
                            <div>
                                <label class="form-label">Tuition Fee (PKR)</label>
                                <input type="number" name="tuitionFee" class="form-control" value="25000" min="0" required />
                            </div>
                            <div>
                                <label class="form-label">Library Fee (PKR)</label>
                                <input type="number" name="libraryFee" class="form-control" value="1000" min="0" required />
                            </div>
                            @if (req.WantsTransport)
                            {
                                <div>
                                    <label class="form-label">Transport Fee (PKR) 🚌</label>
                                    <input type="number" name="transportFee" class="form-control" value="3000" min="0" required />
                                </div>
                            }
                            else
                            {
                                <input type="hidden" name="transportFee" value="0" />
                            }
                            @if (req.WantsHostel)
                            {
                                <div>
                                    <label class="form-label">Hostel Fee (PKR) 🏠</label>
                                    <input type="number" name="hostelFee" class="form-control" value="8000" min="0" required />
                                </div>
                            }
                            else
                            {
                                <input type="hidden" name="hostelFee" value="0" />
                            }
                            <div>
                                <label class="form-label">Due Date</label>
                                <input type="date" name="dueDate" class="form-control"
                                       value="@DateTime.Today.AddMonths(1).ToString("yyyy-MM-dd")" required />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bi bi-receipt"></i> Generate Challan for @req.StudentName
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
}

<!-- Toolbar -->
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:10px;">
    <form method="get" style="display:flex;gap:8px;flex-wrap:wrap;">
        <select name="status" class="form-control" style="width:200px;" onchange="this.form.submit()">
            <option value="">All Status</option>
            <option value="Paid" @(ViewBag.FilterStatus == "Paid" ? "selected" : "")>✅ Paid</option>
            <option value="Pending Verification" @(ViewBag.FilterStatus == "Pending Verification" ? "selected" : "")>⏳ Pending Verification</option>
            <option value="Unpaid" @(ViewBag.FilterStatus == "Unpaid" ? "selected" : "")>❌ Unpaid</option>
        </select>
        <input type="text" name="search" value="@ViewBag.Search" class="form-control"
               style="width:220px;" placeholder="Search name or Fee ID..." />
        <button type="submit" class="btn btn-secondary btn-sm"><i class="bi bi-search"></i></button>
        <a href="/Admin/Fees" class="btn btn-secondary btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
    </form>
    <button onclick="openModal('addFeeModal')" class="btn btn-primary">
        <i class="bi bi-plus-circle-fill"></i> Add Fee Manually
    </button>
</div>

<!-- Alerts -->
@if (pendingVer > 0)

{
    <div class="alert alert-info" style="margin-bottom:16px;">
        <i class="bi bi-hourglass-split"></i>
        <strong>@pendingVer student(s)</strong> submitted payment proof — review and approve below.
    </div>
}

<!-- Fee Records Table -->
<div class="card">
    <div class="card-header">
        <span class="card-title">
            <i class="bi bi-receipt" style="color:#6C63FF;margin-right:6px;"></i>All Fee Records (@Model.Count)
        </span>
        <span class="badge badge-info">
            @Model.Count(f => f.Status == "Paid") paid &middot;
            @Model.Count(f => f.Status == "Pending Verification") pending &middot;
            @Model.Count(f => f.Status == "Unpaid") unpaid
        </span>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Challan ID</th><th>Student</th><th>Tuition</th><th>Library</th><th>Transport</th><th>Hostel</th><th>Total</th><th>Due Date</th><th>Status</th><th>Action</th></tr>
            </thead>
            <tbody>
                @foreach (var f in Model)

                {
                    var overdue = f.Status == "Unpaid" && f.DueDate < DateTime.Today;
                    <tr style="@(f.Status == "Pending Verification" ? "background:#FFFBEB;" : "")">
                        <td><span style="font-size:11px;font-weight:800;color:#6C63FF;font-family:monospace;">@f.FeeId</span></td>
                        <td>
                            <div style="font-weight:700;font-size:13px;">@f.StudentName</div>
                            <div style="font-size:11px;color:#94A3B8;">@f.Program · Sem @f.SemesterNo</div>
                        </td>
                        <td>PKR @f.TuitionFee.ToString("N0")</td>
                        <td>PKR @f.LibraryFee.ToString("N0")</td>
                        <td>
                            @if (f.HasTransport)
                            {
                                <span class="badge badge-info">PKR @f.TransportFee.ToString("N0")</span>
                            }

                            else
                            {
                                <span style="color:#CBD5E1;">—</span>
                            }
                        </td>
                        <td>
                            @if (f.HasHostel)
                            {
                                <span class="badge badge-purple">PKR @f.HostelFee.ToString("N0")</span>
                            }

                            else
                            {
                                <span style="color:#CBD5E1;">—</span>
                            }
                        </td>
                        <td><strong>PKR @f.TotalFee.ToString("N0")</strong></td>
                        <td style="@(overdue ? "color:#E11D48;font-weight:700;" : "")font-size:12px;">
                            @f.DueDate.ToString("dd MMM yyyy")
                            @if (overdue)
                            {
                                <span class="badge badge-danger" style="font-size:10px;margin-left:3px;">Overdue</span>
                            }
                        </td>
                        <td>
                            @if (f.Status == "Paid")

                            {
                                <span class="badge badge-success"><i class="bi bi-check-circle-fill"></i> Paid</span>
                                if (f.PaidAt.HasValue)
                                {
                                    <div style="font-size:10px;color:#94A3B8;margin-top:2px;">@f.PaidAt.Value.ToString("dd MMM yyyy")</div>
                                }

                            }

                            else if (f.Status == "Pending Verification")

                            {
                                <span class="badge badge-warning"><i class="bi bi-hourglass-split"></i> Proof Submitted</span>
                                if (f.ProofSubmittedAt.HasValue)
                                {
                                    <div style="font-size:10px;color:#94A3B8;margin-top:2px;">@f.ProofSubmittedAt.Value.ToString("dd MMM yyyy")</div>
                                }

                            }

                            else
                            {
                                <span class="badge badge-danger"><i class="bi bi-clock-fill"></i> Unpaid</span>
                            }
                        </td>
                        <td>
                            <div style="display:flex;gap:4px;flex-wrap:wrap;">
                                @if (f.Status == "Pending Verification")

                                {

                                    if (!string.IsNullOrEmpty(f.PaymentProofPath))

                                    {
                                        <a href="@f.PaymentProofPath" target="_blank" class="btn btn-secondary btn-sm">
                                            <i class="bi bi-eye"></i> Proof
                                        </a>
                                    }
                                    <form method="post" action="/Admin/MarkFeePaid/@f.Id" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i> Approve</button>
                                    </form>
                                    <form method="post" action="/Admin/MarkFeeUnpaid/@f.Id" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-x-lg"></i> Reject</button>
                                    </form>
                                }

                                else if (f.Status == "Unpaid")

                                {
                                    <form method="post" action="/Admin/MarkFeePaid/@f.Id" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i></button>
                                    </form>
                                }

                                else

                                {
                                    <form method="post" action="/Admin/MarkFeeUnpaid/@f.Id" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-secondary btn-sm"><i class="bi bi-arrow-counterclockwise"></i></button>
                                    </form>
                                }
                                <form method="post" action="/Admin/DeleteFee/@f.Id" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-danger btn-sm"
                                            onclick="if(confirm('Delete @f.FeeId?'))this.closest('form').submit()">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="empty-state"><i class="bi bi-receipt"></i><h4>No Fee Records</h4></div>
        }
    </div>
</div>

<!-- Add Fee Manually Modal -->
<div class="modal-backdrop" id="addFeeModal">
    <div class="modal" style="max-width:540px;">
        <div class="modal-title"><i class="bi bi-receipt" style="color:#6C63FF;margin-right:8px;"></i>Add Fee Manually</div>
        <form method="post" action="/Admin/CreateFee">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label">Student *</label>
                <select name="StudentId" class="form-control" required>
                    <option value="">— Select Student —</option>
                    @foreach (var s in students)

                    {
                        <option value="@s.Id">@s.Name (@s.Program · Sem @s.SemesterNo)</option>
                    }
                </select>
            </div>
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Tuition Fee</label>
                    <input type="number" name="TuitionFee" class="form-control" value="25000" min="0" oninput="calcTotal()" />
                </div>
                <div class="form-group">
                    <label class="form-label">Library Fee</label>
                    <input type="number" name="LibraryFee" class="form-control" value="1000" min="0" oninput="calcTotal()" />
                </div>
                <div class="form-group">
                    <label class="form-label">Transport Fee</label>
                    <input type="number" name="TransportFee" id="tFee" class="form-control" value="3000" min="0" oninput="calcTotal()" />
                </div>
                <div class="form-group">
                    <label class="form-label">Hostel Fee</label>
                    <input type="number" name="HostelFee" id="hFee" class="form-control" value="8000" min="0" oninput="calcTotal()" />
                </div>
            </div>
            <div style="display:flex;gap:20px;margin-bottom:14px;padding:12px;background:#F8FAFC;border-radius:9px;border:1px solid #E2E8F0;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13.5px;font-weight:600;">
                    <input type="checkbox" name="HasTransport" id="chkTrans" value="true" onchange="calcTotal()" /> 🚌 Include Transport
                </label>
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13.5px;font-weight:600;">
                    <input type="checkbox" name="HasHostel" id="chkHostel" value="true" onchange="calcTotal()" /> 🏠 Include Hostel
                </label>
            </div>
            <div id="totalDisplay" style="background:#EDE9FE;border:1px solid #C4B5FD;border-radius:9px;padding:10px 14px;margin-bottom:14px;font-size:14px;font-weight:700;color:#4338CA;">
                Total: PKR 26,000
            </div>
            <div class="form-group">
                <label class="form-label">Due Date</label>
                <input type="date" name="DueDate" class="form-control" value="@DateTime.Today.AddMonths(1).ToString("yyyy-MM-dd")" />
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closeModal('addFeeModal')" class="btn btn-secondary">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-plus-circle-fill"></i> Create</button>
            </div>
        </form>
    </div>
</div>

<script>
    function calcTotal() {
        var t = parseFloat(document.querySelector('[name=TuitionFee]').value) || 0;
        var l = parseFloat(document.querySelector('[name=LibraryFee]').value) || 0;
        var tr = document.getElementById('chkTrans').checked ? (parseFloat(document.getElementById('tFee').value) || 0) : 0;
        var h = document.getElementById('chkHostel').checked ? (parseFloat(document.getElementById('hFee').value) || 0) : 0;
        document.getElementById('totalDisplay').textContent = 'Total: PKR ' + (t + l + tr + h).toLocaleString('en-PK');
    }
    calcTotal();
</script>
