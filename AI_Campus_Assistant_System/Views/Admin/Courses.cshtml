@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    ViewData["Title"] = "Courses";

    var courses = ViewBag.Courses as List<AI_Campus_Assistant.Models.Course> ?? new();
}

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;">
    <div style="font-size:14px;color:#64748B;">Total: <strong style="color:#0F172A;">@courses.Count</strong> courses</div>
    <a href="/Admin/CreateCourse" class="btn btn-primary"><i class="bi bi-plus-circle-fill"></i> Add Course</a>
</div>

<div class="card">
    <div class="card-header">
        <span class="card-title"><i class="bi bi-book-fill" style="color:#6C63FF;margin-right:6px;"></i>All Courses</span>
        <input type="text" placeholder="Search courses..." class="form-control"
               style="width:220px;padding:7px 12px;font-size:13px;"
               oninput="filterTable(this,'coursesTable')" id="searchInput" />
    </div>
    <div class="table-wrap">
        <table id="coursesTable">
            <thead>
                <tr>
                    <th>Course</th>
                    <th>Code</th>
                    <th>Program</th>
                    <th>Semester</th>
                    <th>Teacher</th>
                    <th>Credits</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in courses)

                {
                    <tr>
                        <td>
                            <div style="font-weight:700;font-size:13.5px;">@c.Title</div>
                            @if (!string.IsNullOrEmpty(c.DepartmentName))

                            {
                                <div style="font-size:11px;color:#94A3B8;">@c.DepartmentName</div>
                            }
                        </td>
                        <td><span class="badge badge-info">@c.Code</span></td>
                        <td style="font-size:13px;">@c.Program</td>
                        <td style="font-size:13px;">Sem @c.SemesterNo</td>
                        <td style="font-size:13px;color:#475569;">@(c.TeacherName ?? "—")</td>
                        <td><span class="badge badge-purple">@c.Credits cr</span></td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="badge badge-success">Active</span>
                            }

                            else
                            {
                                <span class="badge badge-danger">Inactive</span>
                            }
                        </td>
                        <td>
                            <div style="display:flex;gap:6px;">
                                <a href="/Admin/EditCourse/@c.Id" class="btn btn-secondary btn-sm"><i class="bi bi-pencil-fill"></i></a>

                                @* Delete Form *@
                                <form id="dc-@c.Id" method="post" action="/Admin/DeleteCourse/@c.Id" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-danger btn-sm"
                                            onclick="confirmDelete('dc-@c.Id','@c.Title')">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!courses.Any())

        {
            <div class="empty-state"><i class="bi bi-book"></i><h4>No Courses Yet</h4><p>Add your first course to get started.</p></div>
        }
    </div>
</div>

<script>
    // Search filter function
    function filterTable(inp, tableId) {
        const q = inp.value.toLowerCase();
        document.querySelectorAll(`#${tableId} tbody tr`).forEach(r => {
            r.style.display = r.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    }

    // Fixed Delete Confirmation Function
    function confirmDelete(formId, courseTitle) {
        if (confirm("Are you sure you want to delete '" + courseTitle + "'?")) {
            document.getElementById(formId).submit();
        }
    }
</script>