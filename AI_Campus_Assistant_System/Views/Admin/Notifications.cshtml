@model List<AI_Campus_Assistant.Models.Notification>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Notifications";
}

<div style="display:flex;justify-content:flex-end;margin-bottom:18px;">
  <button onclick="openModal('addNotifModal')" class="btn btn-primary">
    <i class="bi bi-bell-fill"></i> Send Notification
  </button>
</div>

<div class="card">
  <div class="card-header">
    <span class="card-title"><i class="bi bi-bell-fill" style="color:#D97706;margin-right:6px;"></i>All Notifications (@Model.Count)</span>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Title</th><th>Message</th><th>Target</th><th>Type</th><th>Date</th><th>Action</th></tr>
      </thead>
      <tbody>
        @foreach (var n in Model)
        {
          var typeBadge = n.Type == "success" ? "badge-success" : n.Type == "warning" ? "badge-warning" : n.Type == "danger" ? "badge-danger" : "badge-info";
          <tr>
            <td style="font-weight:700;font-size:13.5px;">@n.Title</td>
            <td style="font-size:13px;color:#475569;max-width:260px;">
              <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:250px;" title="@n.Message">@n.Message</div>
            </td>
            <td>
              @if (n.TargetRole == "all") { <span class="badge badge-purple">Everyone</span> }
              else if (n.TargetRole == "student") { <span class="badge badge-info">Students</span> }
              else { <span class="badge badge-success">Teachers</span> }
            </td>
            <td><span class="badge @typeBadge">@n.Type</span></td>
            <td style="font-size:12px;color:#94A3B8;">@n.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
            <td>
              <form id="dn-@n.Id" method="post" action="/Admin/DeleteNotification/@n.Id" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="button" class="btn btn-danger btn-sm"
                        onclick="confirmDelete('dn-@n.Id','this notification')">
                  <i class="bi bi-trash-fill"></i>
                </button>
              </form>
            </td>
          </tr>
        }
      </tbody>
    </table>
    @if (!Model.Any())
    {
      <div class="empty-state"><i class="bi bi-bell-slash"></i><h4>No Notifications</h4><p>Send your first notification.</p></div>
    }
  </div>
</div>

<!-- Add Notification Modal -->
<div class="modal-backdrop" id="addNotifModal">
  <div class="modal">
    <div class="modal-title"><i class="bi bi-bell-fill" style="color:#D97706;margin-right:8px;"></i>Send Notification</div>
    <form method="post" action="/Admin/CreateNotification">
      @Html.AntiForgeryToken()
      <div class="form-group">
        <label class="form-label">Title *</label>
        <input type="text" name="Title" class="form-control" placeholder="Notification title" required/>
      </div>
      <div class="form-group">
        <label class="form-label">Message *</label>
        <textarea name="Message" class="form-control" rows="3" placeholder="Write your notification message..." required style="resize:vertical;"></textarea>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label">Target Audience</label>
          <select name="TargetRole" class="form-control">
            <option value="all">Everyone</option>
            <option value="student">Students Only</option>
            <option value="teacher">Teachers Only</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Type</label>
          <select name="Type" class="form-control">
            <option value="info">Info (Blue)</option>
            <option value="success">Success (Green)</option>
            <option value="warning">Warning (Amber)</option>
            <option value="danger">Danger (Red)</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" onclick="closeModal('addNotifModal')" class="btn btn-secondary">Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-send-fill"></i> Send</button>
      </div>
    </form>
  </div>
</div>
<script src="/js/site.js"></script>
