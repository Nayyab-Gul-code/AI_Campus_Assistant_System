@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Sign In — AI Smart Campus</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',sans-serif;min-height:100vh;display:flex;background:#F0F4FB;}

.auth-left{width:52%;min-height:100vh;background:linear-gradient(145deg,#071B38 0%,#0F3060 45%,#1A6FD4 100%);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48px;position:relative;overflow:hidden;}
.auth-left::before{content:'';position:absolute;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(106,163,255,.12) 0%,transparent 70%);top:-120px;right:-120px;}
.auth-left::after{content:'';position:absolute;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle,rgba(52,211,153,.07) 0%,transparent 70%);bottom:-80px;left:-80px;}
.fdot{position:absolute;border-radius:50%;opacity:.2;animation:floatDot 6s infinite;}
.fd1{width:8px;height:8px;background:#60A5FA;top:22%;left:18%;animation-duration:6s;}
.fd2{width:5px;height:5px;background:#34D399;top:60%;right:22%;animation-delay:1s;animation-duration:8s;}
.fd3{width:12px;height:12px;background:#A78BFA;bottom:30%;left:12%;animation-delay:2s;animation-duration:7s;}
.fd4{width:6px;height:6px;background:#FCD34D;top:38%;right:15%;animation-delay:.5s;animation-duration:5s;}
@@keyframes floatDot
{0%,100%{transform:translateY(0);}50%{transform:translateY(-14px);}}

.left-content{position:relative;z-index:2;max-width:400px;width:100%;}
.brand{display:flex;align-items:center;gap:14px;margin-bottom:48px;}
.brand-icon{width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#1A6FD4,#60A5FA);display:flex;align-items:center;justify-content:center;font-size:24px;box-shadow:0 8px 24px rgba(26,111,212,.4);}
.brand-name{color:#fff;font-size:20px;font-weight:800;letter-spacing:-.4px;}
.brand-sub{color:rgba(255,255,255,.45);font-size:11px;letter-spacing:.5px;text-transform:uppercase;}
.left-h1{color:#fff;font-size:36px;font-weight:800;line-height:1.18;letter-spacing:-.8px;}
.left-h1 span{color:#60A5FA;}
.left-p{color:rgba(255,255,255,.55);font-size:14.5px;line-height:1.6;margin-top:14px;}

.features{margin-top:36px;display:flex;flex-direction:column;gap:12px;}
.feat{display:flex;align-items:center;gap:14px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:13px 16px;}
.feat-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0;}
.fi-blue{background:rgba(96,165,250,.2);}
.fi-green{background:rgba(52,211,153,.2);}
.fi-purple{background:rgba(167,139,250,.2);}
.feat-title{color:#fff;font-size:13px;font-weight:600;}
.feat-desc{color:rgba(255,255,255,.45);font-size:11.5px;}

.stats-strip{display:flex;margin-top:40px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:14px;overflow:hidden;}
.stat-s{flex:1;padding:14px;text-align:center;border-right:1px solid rgba(255,255,255,.06);}
.stat-s:last-child{border-right:none;}
.stat-s-val{color:#fff;font-size:22px;font-weight:800;}
.stat-s-lbl{color:rgba(255,255,255,.4);font-size:10.5px;text-transform:uppercase;letter-spacing:.5px;margin-top:2px;}

.auth-right{flex:1;display:flex;align-items:center;justify-content:center;padding:40px 32px;background:#fff;}
.form-wrap{width:100%;max-width:400px;}
.form-head{margin-bottom:28px;}
.form-head h2{font-size:26px;font-weight:800;color:#0F172A;letter-spacing:-.5px;}
.form-head p{color:#64748B;font-size:13.5px;margin-top:6px;}

.role-tabs{display:flex;gap:8px;margin-bottom:24px;background:#F1F5F9;border-radius:12px;padding:5px;}
.role-tab{flex:1;padding:8px 6px;border-radius:8px;display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer;border:none;background:transparent;transition:all .18s;color:#64748B;font-family:'Inter',sans-serif;}
.role-tab i{font-size:17px;}
.role-tab span{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;}
.rt-student.sel{background:#fff;color:#1A6FD4;box-shadow:0 2px 8px rgba(0,0,0,.1);}
.rt-teacher.sel{background:#fff;color:#0D9069;box-shadow:0 2px 8px rgba(0,0,0,.1);}
.rt-admin.sel{background:#fff;color:#6C63FF;box-shadow:0 2px 8px rgba(0,0,0,.1);}

.fg{margin-bottom:16px;}
.fl{display:block;font-size:12.5px;font-weight:700;color:#374151;margin-bottom:6px;}
.fl-row{display:flex;justify-content:space-between;align-items:center;}
.iw{position:relative;}
.iw i.left{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#9CA3AF;font-size:14px;pointer-events:none;}
.fi{width:100%;padding:11px 14px 11px 40px;border:1.5px solid #E2E8F0;border-radius:10px;font-size:13.5px;color:#0F172A;background:#F8FAFC;outline:none;transition:all .18s;font-family:'Inter',sans-serif;}
.fi:focus{border-color:#1A6FD4;background:#fff;box-shadow:0 0 0 3px rgba(26,111,212,.1);}
.fi.admin-focus:focus{border-color:#6C63FF;box-shadow:0 0 0 3px rgba(108,99,255,.1);}
.fi.teacher-focus:focus{border-color:#0D9069;box-shadow:0 0 0 3px rgba(13,144,105,.1);}
.pw-toggle{position:absolute;right:13px;top:50%;transform:translateY(-50%);color:#9CA3AF;cursor:pointer;font-size:15px;border:none;background:none;padding:0;}
.forgot{font-size:12px;color:#1A6FD4;font-weight:500;text-decoration:none;}
.forgot:hover{text-decoration:underline;}

.err-box{background:#FFF1F2;border:1px solid #FCA5A5;color:#9F1239;padding:11px 15px;border-radius:10px;font-size:13px;display:flex;align-items:center;gap:8px;margin-bottom:18px;font-weight:500;}
.suc-box{background:#ECFDF5;border:1px solid #A7F3D0;color:#065F46;padding:11px 15px;border-radius:10px;font-size:13px;display:flex;align-items:center;gap:8px;margin-bottom:18px;font-weight:500;}

.btn-submit{width:100%;padding:13px;border-radius:10px;background:linear-gradient(135deg,#1A6FD4,#1d4ed8);color:#fff;font-size:14px;font-weight:700;border:none;cursor:pointer;transition:all .2s;font-family:'Inter',sans-serif;display:flex;align-items:center;justify-content:center;gap:8px;letter-spacing:-.2px;}
.btn-submit:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(26,111,212,.35);}
.btn-admin{background:linear-gradient(135deg,#6C63FF,#4B44CC);}
.btn-admin:hover{box-shadow:0 8px 20px rgba(108,99,255,.35);}
.btn-teacher{background:linear-gradient(135deg,#0D9069,#086B4E);}
.btn-teacher:hover{box-shadow:0 8px 20px rgba(13,144,105,.35);}

.form-foot{text-align:center;margin-top:18px;font-size:13px;color:#64748B;}
.form-foot a{color:#1A6FD4;font-weight:700;text-decoration:none;}
.divider{display:flex;align-items:center;gap:10px;margin:16px 0;color:#CBD5E1;font-size:12px;}
.divider::before,.divider::after{content:'';flex:1;height:1px;background:#E2E8F0;}
.remember-row{display:flex;align-items:center;gap:8px;margin-bottom:18px;}
.remember-row input{width:15px;height:15px;accent-color:#1A6FD4;cursor:pointer;}
.remember-row label{font-size:13px;color:#64748B;cursor:pointer;}

.demo-box{background:#F8FAFC;border:1px solid #E2E8F0;border-radius:10px;padding:12px 14px;margin-top:14px;}
.demo-box-title{font-size:11px;font-weight:700;color:#94A3B8;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;}
.demo-cred{display:flex;align-items:center;justify-content:space-between;padding:5px 0;border-bottom:1px solid #F1F5F9;}
.demo-cred:last-child{border-bottom:none;padding-bottom:0;}
.demo-role{font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px;}
.dr-admin{background:#EDE9FE;color:#6C63FF;}
.dr-teacher{background:#CCFBF1;color:#0D9069;}
.dr-student{background:#EFF6FF;color:#1A6FD4;}
.demo-email{font-size:12px;color:#374151;font-family:monospace;}

@@media(max-width:768px)
{.auth-left{display:none;}.auth-right{padding:28px 20px;}}
</style>
</head>
<body>
<div class="auth-left">
  <div class="fdot fd1"></div><div class="fdot fd2"></div>
  <div class="fdot fd3"></div><div class="fdot fd4"></div>
  <div class="left-content">
    <div class="brand">
      <div class="brand-icon">🎓</div>
      <div><div class="brand-name">AI Campus</div><div class="brand-sub">Smart University Platform</div></div>
    </div>
    <h1 class="left-h1">Welcome to the<br><span>Future of Learning</span></h1>
    <p class="left-p">One platform for students, teachers and admins — powered by AI to make campus life smarter, faster and easier.</p>
    <div class="features">
      <div class="feat">
        <div class="feat-icon fi-blue"><i class="bi bi-robot" style="color:#60A5FA"></i></div>
        <div><div class="feat-title">AI Chat Assistant</div><div class="feat-desc">Instant answers to campus questions 24/7</div></div>
      </div>
      <div class="feat">
        <div class="feat-icon fi-green"><i class="bi bi-bar-chart-fill" style="color:#34D399"></i></div>
        <div><div class="feat-title">Real-time Analytics</div><div class="feat-desc">Grades, attendance and performance tracking</div></div>
      </div>
      <div class="feat">
        <div class="feat-icon fi-purple"><i class="bi bi-bell-fill" style="color:#A78BFA"></i></div>
        <div><div class="feat-title">Smart Notifications</div><div class="feat-desc">Never miss an exam, deadline or update</div></div>
      </div>
    </div>
    <div class="stats-strip">
      <div class="stat-s"><div class="stat-s-val">3</div><div class="stat-s-lbl">Roles</div></div>
      <div class="stat-s"><div class="stat-s-val">AI</div><div class="stat-s-lbl">Powered</div></div>
      <div class="stat-s"><div class="stat-s-val">24/7</div><div class="stat-s-lbl">Support</div></div>
      <div class="stat-s"><div class="stat-s-val">100%</div><div class="stat-s-lbl">Secure</div></div>
    </div>
  </div>
</div>

<div class="auth-right">
  <div class="form-wrap">
    <div class="form-head">
      <h2>Sign In</h2>
      <p>Choose your role and enter your credentials</p>
    </div>

    <div class="role-tabs">
      <button type="button" class="role-tab rt-student sel" id="tabStudent" onclick="setRole('student')">
        <i class="bi bi-mortarboard-fill"></i><span>Student</span>
      </button>
      <button type="button" class="role-tab rt-teacher" id="tabTeacher" onclick="setRole('teacher')">
        <i class="bi bi-person-workspace"></i><span>Teacher</span>
      </button>
      <button type="button" class="role-tab rt-admin" id="tabAdmin" onclick="setRole('admin')">
        <i class="bi bi-shield-fill-check"></i><span>Admin</span>
      </button>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
      foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
      {
        <div class="err-box"><i class="bi bi-exclamation-circle-fill"></i>@err.ErrorMessage</div>
      }
    }
    @if (TempData["Success"] != null)
    {
      <div class="suc-box"><i class="bi bi-check-circle-fill"></i>@TempData["Success"]</div>
    }

    <form method="post" action="/Auth/Login">
      @Html.AntiForgeryToken()
      <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/>

      <div class="fg">
        <label class="fl">Email Address</label>
        <div class="iw">
          <i class="bi bi-envelope-fill left"></i>
          <input type="email" name="email" class="fi" id="emailInput"
                 placeholder="Enter your email" required autocomplete="email"/>
        </div>
      </div>

      <div class="fg">
        <label class="fl fl-row">
          <span>Password</span>
          <a href="#" class="forgot">Forgot password?</a>
        </label>
        <div class="iw">
          <i class="bi bi-lock-fill left"></i>
          <input type="password" name="password" id="pwField" class="fi"
                 placeholder="Enter your password" required autocomplete="current-password"/>
          <button type="button" class="pw-toggle" onclick="togglePw()">
            <i class="bi bi-eye-slash" id="pwIcon"></i>
          </button>
        </div>
      </div>

      <div class="remember-row">
        <input type="checkbox" id="remember"/>
        <label for="remember">Remember me for 8 hours</label>
      </div>

      <button type="submit" class="btn-submit" id="submitBtn">
        <i class="bi bi-box-arrow-in-right"></i> Sign In to Campus
      </button>
    </form>

    <div class="divider">or</div>
    <div class="form-foot">
      Don't have an account? <a href="/Auth/Register">Create Account</a>
    </div>

    <div class="demo-box">
      <div class="demo-box-title">🔑 Demo Credentials</div>
    
     
    </div>
  </div>
</div>

<script>
let currentRole = 'student';
const btnMap   = {student:'',teacher:'btn-teacher',admin:'btn-admin'};
const inputMap = {student:'',teacher:'teacher-focus',admin:'admin-focus'};

function setRole(role) {
  currentRole = role;
  ['student','teacher','admin'].forEach(r => {
    document.getElementById('tab'+r.charAt(0).toUpperCase()+r.slice(1)).classList.remove('sel');
  });
  document.getElementById('tab'+role.charAt(0).toUpperCase()+role.slice(1)).classList.add('sel');
  document.getElementById('submitBtn').className = 'btn-submit ' + (btnMap[role]||'');
  document.querySelectorAll('.fi').forEach(i => {
    i.className = 'fi ' + (inputMap[role]||'');
  });
}

function togglePw() {
  const pw = document.getElementById('pwField');
  const ic = document.getElementById('pwIcon');
  pw.type = pw.type==='password' ? 'text' : 'password';
  ic.className = pw.type==='password' ? 'bi bi-eye-slash' : 'bi bi-eye';
}
</script>
</body>
</html>
